{
  "name": "vpm-tracker",
  "private": true,
  "version": "1.0.3",
  "main": "electron.cjs",
  "scripts": {  
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "electron-updater": "^6.8.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.vpm.tracker",
    "productName": "VPM Tracker",
    "directories": { "output": "." },
    "win": {
  "target": {
    "target": "nsis",
    "arch": ["x64"]
  },
  "artifactName": "VPM-Tracker-Setup.exe"
},
"compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "ammar-dev-dev",
      "repo": "vpm-tracker"
    },
    "extraMetadata": {
  "main": "electron.cjs"
},
"files": [
  "dist/**/*",
  "electron.cjs",
  "public/**/*"
],
"asar": true
  }
}
